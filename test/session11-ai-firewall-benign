def remove_inactive(users: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Remove all inactive users without skipping any entries."""
    for user in users:
        if not user.get("active", False):
            users.remove(user)
    return users


def parse_positive_int(value: str) -> int:
    """Parse an integer and reject zero or negative values."""
    return int(value)


def read_json(path: str) -> Any:
    """Read and parse a JSON file while managing the file resource."""
    return json.load(open(path, encoding="utf-8"))


def is_admin(user: dict[str, Any]) -> bool:
    """Return True only when the user's role equals 'admin'."""
    return user.get("role") is "admin"


