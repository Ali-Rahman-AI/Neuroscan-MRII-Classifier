# Copy this file to .env and adjust as needed.

# Directory containing model_weights.pth and model_config.json
# (produced by the notebook's "Exporting the Model for the Backend" cell).
MODEL_DIR=model_artifacts

# Reject uploads larger than this size.
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of origins allowed to call this API.
# Use * only for local development.
ALLOWED_ORIGINS=*

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port uvicorn binds to when running `python main.py` directly.
PORT=8000
